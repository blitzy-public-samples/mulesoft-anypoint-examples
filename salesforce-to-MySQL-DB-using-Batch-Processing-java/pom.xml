<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 3.2.12 parent: D-005. Empty relativePath: standalone project, D-004 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <!-- Project coordinates: D-003 -->
    <groupId>com.mulesoft.examples</groupId>
    <artifactId>salesforce-to-MySQL-DB-using-Batch-Processing-java</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>salesforce-to-MySQL-DB-using-Batch-Processing-java</name>
    <description>Polls Salesforce Contacts modified since the last watermark and upserts each one into the MySQL contact table.</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <force-partner-api.version>65.0.0</force-partner-api.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- Base value of argLine; jacoco:prepare-agent prepends the agent argument -->
        <argLine></argLine>
    </properties>

    <dependencies>
        <!-- JDBC: NamedParameterJdbcTemplate and HikariCP DataSource -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Jackson: Salesforce OAuth2 token response parsing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- RestClient: Salesforce OAuth2 username-password token request, D-013. No embedded web server -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Salesforce Partner API PartnerConnection and force-wsc ConnectorConfig; Jackson version from the Boot BOM, D-005 -->
        <dependency>
            <groupId>com.force.api</groupId>
            <artifactId>force-partner-api</artifactId>
            <version>${force-partner-api.version}</version>
        </dependency>

        <!-- MySQL JDBC driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test: JUnit Jupiter, Mockito, AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test: H2 in MySQL mode, D-039 and D-074 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test: stub Salesforce token and SOAP endpoints -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable jar: default repackage execution -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Java 17 bytecode -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                    <!-- Emits package-info.class only for a package-info.java that carries an annotation: D-086, D-127 -->
                    <createMissingPackageInfoClass>false</createMissingPackageInfoClass>
                </configuration>
            </plugin>

            <!-- Unit and endpoint tests; *IT.java excluded. sun.net.http.retryPost=false: one attempt per HTTP call, D-020 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <sun.net.http.retryPost>false</sun.net.http.retryPost>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Integration tests: *IT.java, skipped without credentials, D-021. sun.net.http.retryPost=false, D-020 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <sun.net.http.retryPost>false</sun.net.http.retryPost>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Coverage: LINE covered ratio of at least 0.80 on the service and mapper packages, checked in the test phase, D-049 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.mulesoft.examples.salesforce_to_mysql_db_using_batch_processing.service</include>
                                        <include>com.mulesoft.examples.salesforce_to_mysql_db_using_batch_processing.mapper</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build rules: Java 17; banned JAX-WS, CXF and Mule artifacts, D-050 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>17</version>
                                </requireJavaVersion>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>javax.xml.ws:*</exclude>
                                        <exclude>jakarta.xml.ws:*</exclude>
                                        <exclude>com.sun.xml.ws:*</exclude>
                                        <exclude>org.apache.cxf:*</exclude>
                                        <exclude>org.jvnet.jax-ws-commons:*</exclude>
                                        <exclude>org.mule*:*</exclude>
                                        <exclude>com.mulesoft*:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
